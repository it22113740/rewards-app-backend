DATABASE_URL= (Neon Postgres URL for production)
JWT_SECRET= (use a long random string in production)
JWT_EXPIRES_IN=604800
PORT=3000
# Comma-separated allowed browser origins (Expo web / local frontend)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173

# First Hunt superadmin. Applied once, on API startup, after the superadmin migration.
# Ignored when the email already exists. Password must be at least 8 characters.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo SMTP (forgot-password OTP emails)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional self keep-alive ping (runs every 14 minutes via cron in backend)
# If empty, keep-alive cron does nothing.
SELF_PING_URL=

# Optional geofence notification dedupe window in hours (clamped to 2..6)
GEOFENCE_NOTIFY_DEDUPE_HOURS=4